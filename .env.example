# Copy to .env and `set -a; source .env; set +a` (or use `make` which loads it).

# --- Database -------------------------------------------------------------
# The bundled docker Postgres publishes on 5433 by default (override with
# BEPILOT_PG_PORT) to avoid clashing with a local Postgres on 5432.
BEPILOT_PG_PORT=5433
DATABASE_URL=postgres://bepilot:bepilot@localhost:5433/bepilot?sslmode=disable

# --- HTTP ---------------------------------------------------------------—-
BEPILOT_HTTP_ADDR=:8080
BEPILOT_ENV=development
BEPILOT_LOG_LEVEL=info
BEPILOT_LOG_FORMAT=text

# --- Agent / LLM -------------------------------------------------------—-—
# For a zero-dependency local run use the deterministic fake provider:
BEPILOT_DEFAULT_PROVIDER=fake
BEPILOT_DEFAULT_MODEL=bepilot-fake-1

# For real Claude, set these and switch the provider:
# BEPILOT_DEFAULT_PROVIDER=claude
# BEPILOT_DEFAULT_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=

# OpenAI-compatible (also used by the 'openai' embedder). Works with OpenAI,
# Azure, or any local server (LM Studio, llama.cpp, vLLM, Ollama). No API key is
# required for local servers. BASE_URL may be the API base or a full endpoint
# URL — bepilot trims /chat/completions etc. automatically.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Example — LM Studio running locally:
#   BEPILOT_DEFAULT_PROVIDER=openai
#   BEPILOT_DEFAULT_MODEL=<model id shown in LM Studio>
#   OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# --- Retrieval ---------------------------------------------------------—-—
# 'hash' works offline; 'openai' needs OPENAI_API_KEY.
BEPILOT_EMBEDDING_KIND=hash

# --- Skills -----------------------------------------------------------—-—-
BEPILOT_SKILLS_DIR=skills
# Slug the fake provider will load on its first tool-using turn:
BEPILOT_FAKE_SKILL_SLUG=pdf-forms
